#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
usage() {
  printf 'formsculptor %s · 3D sculpting and modeling\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formsculptor [command] [options]

  (none) | boot       boot backend (8196) and frontend (5196) together
  install             install the engine toolchain check, backend and frontend
  install-desktop     install PyInstaller and check the Rust and Tauri toolchain
  backend             boot the backend only
  frontend            boot the frontend only
  engine build        build the Rust engine workspace (native, wasm, python targets as available)
  engine check        cargo check and clippy over the engine workspace
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the backend on 127.0.0.1:8196
  freeze              freeze the backend into the Tauri sidecar binary
  desktop dev|build   run or bundle the desktop app
  doctor              check the toolchain, installs and ports
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  engine)
    sub="${1:-build}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      build) exec setup/engine_build "$@" ;;
      check) exec setup/engine_check "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formsculptor] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
