#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[formsculpt] backend venv missing, run ./formsculpt install" >&2; exit 1; }
# shellcheck disable=SC1091
source venv/bin/activate
exec uvicorn app.main:app --reload --host "${FSC_HOST:-127.0.0.1}" --port "${FSC_PORT:-8260}"
