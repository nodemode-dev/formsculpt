{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormSculpt",
  "version": "1.26.0",
  "identifier": "ai.nodemode.formsculpt",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormSculpt",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D sculpting and modeling",
    "longDescription": "formsculpt is a 3D sculpting and modeling application in the NodeMode design system: a Rust sculpting engine, dynamic topology, multiresolution, remeshing, painting and its own .fsc project files.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formsculpt-engine"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fsc"], "name": "formsculpt Project", "description": "formsculpt sculpting project", "role": "Editor", "mimeType": "application/x-formsculpt" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://dl.formai.studio/formsculpt/updates/latest.json"]
    }
  }
}
