{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formsculptor",
  "version": "0.8.0",
  "identifier": "ai.nodemode.formsculptor",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formsculptor",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D sculpting and modeling",
    "longDescription": "formsculptor is a 3D sculpting and modeling application in the NodeMode design system: a Rust sculpting engine, dynamic topology, multiresolution, remeshing, painting and its own .fsc project files.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formsculptor-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fsc"], "name": "formsculptor Project", "description": "formsculptor sculpting project", "role": "Editor", "mimeType": "application/x-formsculptor" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formsculptor/releases/latest/download/latest.json"]
    }
  }
}
