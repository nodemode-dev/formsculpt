#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOT'
./build_app            build the formsculpt desktop app from this folder, start to finish
  --no-install         macOS: leave the built app where it is instead of copying it to Applications
  --install            Linux: install the built .deb with apt (asks for your password)
  --open               open the app when the build is done
  --clean              rebuild the engine, the Rust shell and the frozen service from nothing
Linux bundles default to deb; set FSC_BUNDLES=deb,rpm,appimage for more.
Every step's output goes to build_app.log beside this file. On Windows run build_app.bat.
EOT
}

install_app=auto open_app=0 clean=0
for arg in "$@"; do
  case "$arg" in
    --no-install) install_app=no ;;
    --install) install_app=yes ;;
    --open) open_app=1 ;;
    --clean) clean=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

log="$FSC_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formsculpt] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT

os="$(fs_os)"
step() { printf '\n[formsculpt] == %s\n' "$*"; }

step "checking the tools"
[ "$os" = macos ] || [ "$os" = linux ] || fs_die "build_app runs on macOS and Linux; on Windows run build_app.bat"
if [ "$os" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || fs_die "the Xcode command line tools are missing: run xcode-select --install, then ./build_app again"
fi
py="$(fs_python)" || fs_die "Python 3.12 or newer is required (on macOS: brew install python)"
command -v node >/dev/null 2>&1 || fs_die "Node 20.19 or 22.12 or newer is required (on macOS: brew install node)"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)||(a===20&&b>=19)?0:1)' \
  || fs_die "Node $(node -v) is too old; Vite needs 20.19 or 22.12 or newer"
fs_rust_env
if ! command -v rustup >/dev/null 2>&1 && ! command -v cargo >/dev/null 2>&1; then
  fs_say "installing Rust with rustup (https://rustup.rs) into ~/.cargo; your shell profile is not changed"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
  fs_rust_env
fi
[ "$(dirname "$(command -v rustc)")" = "$(dirname "$(command -v cargo)")" ] \
  || fs_die "rustc ($(command -v rustc)) and cargo ($(command -v cargo)) come from different installs; remove one (brew uninstall rust) and run ./build_app again"
if [ "$os" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fs_die "Tauri needs system libraries; on Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
fi
if command -v claude >/dev/null 2>&1; then
  fs_say "Claude Code $(claude --version 2>/dev/null | awk '{print $1}') found; the app's terminal dock and Chat can start it"
else
  fs_say "Claude Code is not installed; the app builds without it, and its Claude Code button asks for it (https://claude.com/claude-code)"
fi
fs_say "python $("$py" -c 'import platform; print(platform.python_version())'), node $(node -v), $(rustc -V)"

step "installing the service, the engine module and the window"
if [ -f backend/venv/bin/activate ] && [ -d frontend/node_modules ]; then
  ( cd backend && ./oc_install ) >/dev/null
  ( cd frontend && npm install --no-audit --no-fund )
else
  setup/install_all
fi
step "installing the desktop packages (PyInstaller) and checking the Tauri toolchain"
setup/install_desktop

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && cargo clean )
  ( cd native && cargo clean )
  rm -rf backend/build/pyinstaller backend/dist-engine src-tauri/binaries/formsculpt-engine-*
fi
fs_rust_fresh

step "building the Rust engine and its Python module"
setup/engine_build
if rustup target list --installed 2>/dev/null | grep -q wasm32-unknown-unknown; then
  step "building the browser engine (Rust to WebAssembly)"
  setup/engine_wasm
else
  fs_say "no wasm32 target; skipping the browser engine (the desktop app runs on the bundled service engine)"
fi
step "building the window"
setup/build_frontend
step "freezing the service and engine into the app's sidecar"
setup/freeze_backend
[ -f src-tauri/icons/icon.icns ] || frontend/node_modules/.bin/tauri icon assets/formsculpt_icon.png -o src-tauri/icons

tauri_args=(build)
case "$os" in
  macos)
    tauri_args+=(--bundles app)
    [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || tauri_args+=(--config '{"bundle":{"macOS":{"signingIdentity":"-"}}}')
    ;;
  linux) tauri_args+=(--bundles "${FSC_BUNDLES:-deb}") ;;
esac

step "building the desktop app (the first build compiles several hundred Rust crates)"
tlog="$(mktemp)"
if ! frontend/node_modules/.bin/tauri "${tauri_args[@]}" 2>&1 | tee "$tlog"; then
  grep -Eq 'error\[E|could not compile' "$tlog" || fs_die "tauri build failed outside the Rust compile; see the lines above"
  fs_say "the Rust compile failed; cleaning src-tauri/target and trying once more"
  ( cd src-tauri && cargo clean )
  fs_rust_fresh
  frontend/node_modules/.bin/tauri "${tauri_args[@]}" || fs_die "tauri build failed twice; send build_app.log"
fi
rm -f "$tlog"

bundle="$FSC_ROOT/src-tauri/target/release/bundle"
version="$("$py" -c 'import json; print(json.load(open("src-tauri/tauri.conf.json"))["version"])')"

if [ "$os" = macos ]; then
  app="$bundle/macos/formsculpt.app"
  [ -d "$app" ] || fs_die "the build finished but $app is missing"
  codesign --verify --deep --strict "$app" 2>/dev/null || fs_say "codesign could not verify the app; it is ad-hoc signed, so macOS may ask once before it opens"
  step "packing the disk image"
  mkdir -p "$bundle/dmg"
  dmg="$bundle/dmg/formsculpt_${version}_$(uname -m).dmg"
  stage="$(mktemp -d)"
  ditto "$app" "$stage/formsculpt.app"
  ln -s /Applications "$stage/Applications"
  rm -f "$dmg"
  hdiutil create -quiet -volname formsculpt -srcfolder "$stage" -ov -format UDZO "$dmg"
  rm -rf "$stage"
  fs_say "app: $app"
  fs_say "disk image: $dmg"
  target_app=""
  if [ "$install_app" != no ]; then
    dest=/Applications
    [ -w "$dest" ] || { dest="$HOME/Applications"; mkdir -p "$dest"; }
    if pgrep -x formsculpt >/dev/null 2>&1; then
      osascript -e 'tell application "formsculpt" to quit' >/dev/null 2>&1 || true
      sleep 2
    fi
    rm -rf "$dest/formsculpt.app"
    ditto "$app" "$dest/formsculpt.app"
    xattr -dr com.apple.quarantine "$dest/formsculpt.app" 2>/dev/null || true
    target_app="$dest/formsculpt.app"
    fs_say "installed: $target_app"
  fi
  if [ "$open_app" = 1 ]; then open "${target_app:-$app}"; fi
else
  for kind in deb rpm appimage; do
    for f in "$bundle/$kind"/*; do
      [ -f "$f" ] && fs_say "$kind: $f"
    done
  done
  deb="$(ls -t "$bundle"/deb/*.deb 2>/dev/null | head -1 || true)"
  if [ "$install_app" = yes ] && [ -n "$deb" ]; then
    sudo apt install -y "$deb"
  elif [ -n "$deb" ]; then
    fs_say "install it with: sudo apt install $deb   (or run ./build_app --install)"
  fi
  if [ "$open_app" = 1 ]; then "$FSC_ROOT/src-tauri/target/release/formsculpt" >/dev/null 2>&1 & fi
fi
fs_say "formsculpt $version built in ${SECONDS}s"
