#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
command -v cargo >/dev/null 2>&1 || fs_say "Rust is not installed; the engine needs it. Install from https://rustup.rs"
fs_say "installing backend"
( cd "$FSC_ROOT/backend" && ./oc_install )
fs_say "installing frontend"
( cd "$FSC_ROOT/frontend" && ./oc_install )
fs_say "done. Boot with ./formsculptor"
