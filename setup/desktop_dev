#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
triple="$(fs_target_triple)" || fs_die "rustc not found; run ./formsculpt install-desktop"
[ -x "$FSC_ROOT/src-tauri/binaries/formsculpt-engine-${triple}$(fs_exe)" ] || "$FSC_ROOT/setup/freeze_backend"
cd "$FSC_ROOT"
exec frontend/node_modules/.bin/tauri dev "$@"
