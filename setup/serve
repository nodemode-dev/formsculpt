#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$FSC_ROOT/frontend/dist/index.html" ] || "$FSC_ROOT/setup/build_frontend"
fs_venv
cd "$FSC_ROOT/backend"
export FSC_DIST="$FSC_ROOT/frontend/dist"
fs_say "serving http://127.0.0.1:${FSC_PORT:-8260}"
exec uvicorn app.main:app --host 127.0.0.1 --port "${FSC_PORT:-8260}"
